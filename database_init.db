-- =============================================================
-- SCRIPT KHỞI TẠO DATABASE (SCHEMA) - ENGLISH MASTER
-- =============================================================

-- 1. Kích hoạt extension pgcrypto để dùng gen_random_uuid()
CREATE EXTENSION IF NOT EXISTS pgcrypto;

-- 2. Xóa các bảng cũ (Thứ tự xóa ngược với quan hệ khóa ngoại)
DROP TABLE IF EXISTS public.user_answers CASCADE;
DROP TABLE IF EXISTS public.test_results CASCADE;
DROP TABLE IF EXISTS public.notifications CASCADE;
DROP TABLE IF EXISTS public.flashcards CASCADE;
DROP TABLE IF EXISTS public.question_options CASCADE;
DROP TABLE IF EXISTS public.questions CASCADE;
DROP TABLE IF EXISTS public.tests CASCADE;
DROP TABLE IF EXISTS public.reading_passages CASCADE;
DROP TABLE IF EXISTS public.grammar_examples CASCADE;
DROP TABLE IF EXISTS public.grammar_topics CASCADE;
DROP TABLE IF EXISTS public.vocabulary_words CASCADE;
DROP TABLE IF EXISTS public.vocabulary_topics CASCADE;
DROP TABLE IF EXISTS public.users CASCADE;

-- 3. Xóa và tạo lại các kiểu dữ liệu ENUM
DROP TYPE IF EXISTS public.difficulty_level CASCADE;
DROP TYPE IF EXISTS public.notif_type CASCADE;
DROP TYPE IF EXISTS public.proficiency_level CASCADE;
DROP TYPE IF EXISTS public.question_type CASCADE;
DROP TYPE IF EXISTS public.skill_type CASCADE;
DROP TYPE IF EXISTS public.test_category CASCADE;
DROP TYPE IF EXISTS public.user_role CASCADE;

CREATE TYPE public.difficulty_level AS ENUM ('EASY', 'MEDIUM', 'HARD');
CREATE TYPE public.notif_type AS ENUM ('info', 'success', 'warning');
CREATE TYPE public.proficiency_level AS ENUM ('Beginner', 'Intermediate', 'Advanced');
CREATE TYPE public.question_type AS ENUM ('multiple-choice', 'text');
CREATE TYPE public.skill_type AS ENUM ('LISTENING', 'READING', 'GRAMMAR', 'VOCABULARY');
CREATE TYPE public.test_category AS ENUM ('TOEIC', 'IELTS', 'HSK', 'JLPT', 'GENERAL', 'GRAMMAR', 'VOCABULARY');
CREATE TYPE public.user_role AS ENUM ('user', 'admin');

-- 4. Tạo các hàm và trigger (Cập nhật thời gian)
CREATE OR REPLACE FUNCTION public.update_updated_at() RETURNS trigger AS $$
BEGIN
  NEW.updated_at = NOW();
  RETURN NEW;
END;
$$ LANGUAGE plpgsql;

-- 5. Bảng USERS
CREATE TABLE public.users (
    id uuid DEFAULT gen_random_uuid() PRIMARY KEY,
    name varchar(100) NOT NULL,
    email varchar(255) UNIQUE NOT NULL,
    password_hash text NOT NULL,
    role public.user_role DEFAULT 'user',
    avatar_url text,
    daily_goal_target integer DEFAULT 5,
    created_at timestamptz DEFAULT now(),
    updated_at timestamptz DEFAULT now()
);

CREATE TRIGGER trg_users_updated_at BEFORE UPDATE ON public.users FOR EACH ROW EXECUTE FUNCTION public.update_updated_at();

-- 6. Bảng VOCABULARY
CREATE TABLE public.vocabulary_topics (
    id uuid DEFAULT gen_random_uuid() PRIMARY KEY,
    title varchar(200) NOT NULL,
    description text,
    icon_name varchar(50),
    created_at timestamptz DEFAULT now()
);

CREATE TABLE public.vocabulary_words (
    id uuid DEFAULT gen_random_uuid() PRIMARY KEY,
    topic_id uuid NOT NULL REFERENCES public.vocabulary_topics(id) ON DELETE CASCADE,
    word varchar(200) NOT NULL,
    word_type varchar(50),
    meaning text NOT NULL,
    example text,
    phonetics varchar(200),
    audio_url text,
    order_index integer DEFAULT 0
);

-- 7. Bảng GRAMMAR
CREATE TABLE public.grammar_topics (
    id uuid DEFAULT gen_random_uuid() PRIMARY KEY,
    title varchar(200) NOT NULL,
    content text NOT NULL,
    order_index integer DEFAULT 0,
    created_at timestamptz DEFAULT now()
);

CREATE TABLE public.grammar_examples (
    id uuid DEFAULT gen_random_uuid() PRIMARY KEY,
    grammar_topic_id uuid NOT NULL REFERENCES public.grammar_topics(id) ON DELETE CASCADE,
    example_text text NOT NULL,
    translation text,
    order_index integer DEFAULT 0
);

-- 8. Bảng TESTS & READING
CREATE TABLE public.tests (
    id uuid DEFAULT gen_random_uuid() PRIMARY KEY,
    title varchar(200) NOT NULL,
    description text,
    category public.test_category NOT NULL,
    year integer,
    duration_minutes integer DEFAULT 45 NOT NULL,
    total_questions integer DEFAULT 0 NOT NULL,
    created_at timestamptz DEFAULT now(),
    updated_at timestamptz DEFAULT now()
);

CREATE TRIGGER trg_tests_updated_at BEFORE UPDATE ON public.tests FOR EACH ROW EXECUTE FUNCTION public.update_updated_at();

CREATE TABLE public.reading_passages (
    id uuid DEFAULT gen_random_uuid() PRIMARY KEY,
    title varchar(200) NOT NULL,
    content text NOT NULL,
    difficulty public.difficulty_level DEFAULT 'MEDIUM',
    reading_time integer,
    created_at timestamptz DEFAULT now()
);

-- 9. Bảng QUESTIONS & OPTIONS
CREATE TABLE public.questions (
    id uuid DEFAULT gen_random_uuid() PRIMARY KEY,
    test_id uuid REFERENCES public.tests(id) ON DELETE CASCADE,
    reading_id uuid REFERENCES public.reading_passages(id) ON DELETE SET NULL,
    type public.question_type DEFAULT 'multiple-choice',
    text text NOT NULL,
    correct_answer text NOT NULL,
    explanation text,
    part_number integer,
    audio_url text,
    image_url text,
    passage_text text,
    skill public.skill_type NOT NULL,
    order_index integer DEFAULT 0,
    created_at timestamptz DEFAULT now()
);

CREATE TABLE public.question_options (
    id uuid DEFAULT gen_random_uuid() PRIMARY KEY,
    question_id uuid NOT NULL REFERENCES public.questions(id) ON DELETE CASCADE,
    option_text text NOT NULL,
    order_index integer NOT NULL
);

-- 10. Bảng RESULTS & ANSWERS
CREATE TABLE public.test_results (
    id uuid DEFAULT gen_random_uuid() PRIMARY KEY,
    user_id uuid NOT NULL REFERENCES public.users(id) ON DELETE CASCADE,
    test_id uuid NOT NULL REFERENCES public.tests(id),
    score integer NOT NULL,
    total_questions integer NOT NULL,
    time_taken_seconds integer,
    completed_at timestamptz DEFAULT now()
);

CREATE TABLE public.user_answers (
    id uuid DEFAULT gen_random_uuid() PRIMARY KEY,
    test_result_id uuid NOT NULL REFERENCES public.test_results(id) ON DELETE CASCADE,
    question_id uuid NOT NULL REFERENCES public.questions(id),
    selected_answer text NOT NULL,
    is_correct boolean NOT NULL
);

-- 11. Bảng KHÁC: FLASHCARDS, NOTIFICATIONS
CREATE TABLE public.flashcards (
    id uuid DEFAULT gen_random_uuid() PRIMARY KEY,
    front text NOT NULL,
    back text NOT NULL,
    example text,
    category varchar(100),
    level public.proficiency_level DEFAULT 'Beginner',
    is_system boolean DEFAULT false,
    created_by uuid REFERENCES public.users(id) ON DELETE SET NULL,
    created_at timestamptz DEFAULT now()
);

CREATE TABLE public.notifications (
    id uuid DEFAULT gen_random_uuid() PRIMARY KEY,
    user_id uuid NOT NULL REFERENCES public.users(id) ON DELETE CASCADE,
    title varchar(200) NOT NULL,
    message text,
    type public.notif_type DEFAULT 'info',
    is_read boolean DEFAULT false,
    created_at timestamptz DEFAULT now()
);

-- 12. VIEW LEADERBOARD
CREATE OR REPLACE VIEW public.leaderboard AS
 SELECT u.id AS user_id,
    u.name AS user_name,
    u.email AS user_email,
    u.avatar_url,
    count(tr.id) AS total_tests,
    round(avg((((tr.score)::numeric / (NULLIF(tr.total_questions, 0))::numeric) * (100)::numeric)), 1) AS avg_accuracy,
    COALESCE(sum(tr.score), (0)::bigint) AS total_score
   FROM (public.users u
     LEFT JOIN public.test_results tr ON ((tr.user_id = u.id)))
  GROUP BY u.id, u.name, u.email, u.avatar_url
  ORDER BY COALESCE(sum(tr.score), (0)::bigint) DESC NULLS LAST;
